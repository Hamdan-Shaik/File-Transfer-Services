  "page_texts": {
    "1": "<meta http-equiv=\"Cache-Control\" content=\"no-cache, no-store, must-revalidate\">\n<meta http-equiv=\"Pragma\" content=\"no-cache\">\n<meta http-equiv=\"Expires\" content=\"0\">\n\n<!-- Link to external CSS file with cache busting -->\n<link rel=\"stylesheet\" href=\"search.css\">\n\n<!-- App Banner -->\n<link rel=\"stylesheet\" href=\"../../assets/stylesheets/app-banner.css\">\n\n<div class=\"app-banner\">\n  <div class=\"app-banner-inner\">\n    <div class=\"app-banner-title-area\">\n      <div>\n        <div class=\"app-banner-title\"><span class=\"app-banner-icon\"><img src=\"../../assets/images/icon-aria.svg\" alt=\"Aria\"></span> Ask Aria <span id=\"aria-model-label\" class=\"aria-model-label\"></span></div>\n        <p class=\"app-banner-sub\">Architecture Research &amp; Intelligence Assistant</p>\n      </div>\n    </div>\n    <div class=\"app-banner-badges\">\n      <span class=\"app-badge app-badge-version\" id=\"aria-version-badge\">v1.1.0</span>\n      <span class=\"app-badge app-badge-beta\">BETA</span>\n      <img id=\"pdf-export-btn\" src=\"../../assets/images/icon-pdf.png\" alt=\"Export Chat to PDF\" class=\"app-banner-pdf\" title=\"Export Chat to PDF\" />\n    </div>\n  </div>\n</div>\n\n<!-- HTML Content Start -->\n<div class=\"aria-main-layout\">\n    <!-- Left Sidebar: Chat History -->\n    <div id=\"chat-sidebar\" class=\"aria-chat-sidebar\">\n        <div class=\"aria-chat-history-section\">\n            <div class=\"aria-history-header\">\n                <h4 class=\"aria-history-title\">Chat History</h4>\n                <div class=\"aria-history-buttons\">\n                    <button id=\"new-chat\" class=\"aria-new-chat-btn\" title=\"Start a new chat\">New</button>\n                    <button id=\"clear-history\" class=\"aria-clear-history-btn\" title=\"Clear all chat history\">Clear</button>\n                </div>\n            </div>\n            <div id=\"chat-history-list\" class=\"aria-chat-history-list\">\n                <div class=\"aria-no-chats\">No previous chats</div>\n            </div>\n        </div>\n    </div>\n\n    <!-- Main Chat Area -->\n    <div id=\"ai-search-container\" class=\"aria-main-chat-container\">\n        <div id=\"search-messages\" class=\"search-messages aria-search-messages\">\n            <!-- Welcome message will be initialized by JavaScript -->\n        </div>\n\n        <div id=\"search-input-area\" class=\"search-input-area aria-search-input-section\">\n            <div class=\"input-container aria-input-container\">\n                <select id=\"category-filter\" class=\"aria-category-filter\" style=\"display: none;\">\n                    <option value=\"all\" selected>All Sections</option>\n                    <option value=\"foundation\">Foundation (Root Docs)</option>\n                    <option value=\"guiding-principles\">Guiding Principles</option>\n                    <option value=\"governance\">Governance</option>\n                    <option value=\"products\">Products</option>\n                    <option value=\"decisions\">Decisions</option>\n                    <option value=\"standards\">Standards</option>\n                    <option value=\"strategy\">Strategy</option>\n                    <option value=\"rcas\">RCAs</option>\n                    <option value=\"training\">Training</option>\n                    <option value=\"onboarding\">Onboarding</option>\n                    <option value=\"job-descriptions\">Job Descriptions</option>\n                </select>\n\n                <button id=\"voice-input-btn\" type=\"button\" class=\"aria-voice-input\" title=\"Click to speak your question\" style=\"margin-right: 8px;\">\n                    <span class=\"voice-icon\">🎙</span>\n                    <span class=\"voice-listening\">●</span>\n                </button>\n\n                <input type=\"text\" id=\"search-input\" class=\"aria-search-input aria-search-input-full-width\" placeholder=\"Ask me anything about Gainwell's Reference Enterprise Architecture...\" autocomplete=\"off\">\n\n                <button id=\"search-submit\" type=\"button\" class=\"aria-search-submit\" title=\"Send your question to ARIA\" style=\"margin-left: 6px;\">\n                    <span class=\"search-text\">Search</span>\n                    <span class=\"search-icon\">⚲</span>\n                    <span class=\"loading-icon\">⟳</span>\n                </button>\n\n\n            </div>\n\n            <!-- Interactive Chat Toggle Slider (moved below input) -->\n            <div class=\"aria-interactive-chat-toggle-container\">\n                <div class=\"aria-interactive-chat-toggle-wrapper\">\n                    <!-- Settings buttons moved to far left -->\n                    <div class=\"aria-left-controls\">\n                        <button id=\"voice-settings-toggle\" type=\"button\" class=\"aria-voice-settings-btn\" title=\"Voice Settings\">\n                            <span class=\"voice-settings-icon\">⚙</span>\n                        </button>\n                    </div>\n                    <div class=\"aria-interactive-chat-label\">\n                        <img src=\"../../../../assets/images/aria-icon.svg\" alt=\"ARIA\" class=\"aria-toggle-icon\">\n                        <span class=\"aria-toggle-text\">Interactive Chat Settings</span>\n                    </div>\n                    <div class=\"aria-toggle-slider-container\">\n                        <span class=\"aria-toggle-status-off\">Off</span>\n                        <label for=\"interactive-chat-toggle\" class=\"aria-toggle-slider-label\" title=\"Toggle interactive chat mode - when enabled, ARIA will speak responses aloud and you can use voice input\">\n                            <input type=\"checkbox\" id=\"interactive-chat-toggle\" class=\"aria-toggle-checkbox\">\n                            <div class=\"aria-toggle-slider\">\n                                <div class=\"aria-toggle-slider-track\"></div>\n                                <div class=\"aria-toggle-slider-thumb\">\n                                    <img src=\"../../../../assets/images/aria-icon.svg\" alt=\"ARIA\" class=\"aria-thumb-icon\">\n                                </div>\n                            </div>\n                        </label>\n                        <span class=\"aria-toggle-status-on\">On</span>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Voice Setup Wizard Modal -->\n            <div id=\"voice-setup-wizard\" class=\"voice-setup-wizard\" style=\"display: none;\">\n                <div class=\"wizard-overlay\"></div>\n                <div class=\"wizard-content\">\n                    <div class=\"wizard-header\">\n                        <h3 style=\"color: white;\">Welcome to Aria Voice-Enhanced Search!</h3>\n                        <button id=\"wizard-close\" class=\"wizard-close-btn\" title=\"Skip setup\">✕</button>\n                    </div>\n                    <div class=\"wizard-body\">\n                        <div class=\"wizard-step\" id=\"wizard-step-1\">\n                            <div class=\"wizard-icon\"><img src=\"../../../../assets/images/aria-icon.svg\" alt=\"ARIA\" style=\"width: 96px; height: 96px;\"></div>\n                            <h4>Enhanced Voice Experience</h4>\n                            <p>ARIA now supports both voice input and high-quality text-to-speech! Let's set up your preferences.</p>\n                            <div class=\"wizard-features\">\n                                <div class=\"feature-item\">\n                                    <span class=\"feature-icon\">🗣️</span>\n                                    <span class=\"feature-text\">Speak your questions naturally</span>\n                                </div>\n                                <div class=\"feature-item\">\n                                    <span class=\"feature-icon\">👂</span>\n                                    <span class=\"feature-text\">Listen to responses with premium voices</span>\n                                </div>\n                                <div class=\"feature-item\">\n                                    <span class=\"feature-icon\">⚙️</span>\n                                    <span class=\"feature-text\">Customize speed, pitch, and voice quality</span>\n                                </div>\n                            </div>\n                        </div>\n\n                        <div class=\"wizard-step\" id=\"wizard-step-2\" style=\"display: none;\">\n                            <div class=\"wizard-icon\"><img src=\"../../../../assets/images/aria-icon.svg\" alt=\"ARIA\" style=\"width: 48px; height: 48px;\"></div>\n                            <h4>Voice Settings & Test</h4>\n                            <p>Choose your voice and adjust settings. Test to hear how it sounds:</p>\n\n                            <div class=\"voice-preview-section\">\n                                <div class=\"voice-selection\">\n                                    <label>Voice:</label>\n                                    <select id=\"wizard-voice-select\" class=\"wizard-voice-dropdown\"></select>\n                                </div>\n\n                                <div class=\"wizard-settings\">\n                                    <div class=\"wizard-setting\">\n                                        <label>Speaking Speed:</label>\n                                        <input type=\"range\" id=\"wizard-speed\" min=\"0.7\" max=\"1.5\" step=\"0.1\" value=\"1\">\n                                        <span id=\"wizard-speed-value\">1.0x</span>\n                                    </div>\n                                    <div class=\"wizard-setting\">\n                                        <label>Voice Pitch:</label>\n                                        <input type=\"range\" id=\"wizard-pitch\" min=\"0.8\" max=\"1.2\" step=\"0.1\" value=\"1\">\n                                        <span id=\"wizard-pitch-value\">1.0</span>\n                                    </div>\n                                </div>\n\n                                <button id=\"wizard-test-voice\" class=\"wizard-test-btn\">🔊 Test Voice & Settings</button>\n                            </div>\n\n                            <div class=\"voice-quality-info\">\n                                <p><strong>Found <span id=\"voice-count\">0</span> voices on your system</strong></p>\n                                <p id=\"premium-voice-status\">Checking for premium voices...</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"wizard-footer\">\n                        <button id=\"wizard-skip\" class=\"wizard-btn wizard-skip\">Skip Setup</button>\n                        <button id=\"wizard-prev\" class=\"wizard-btn wizard-secondary\" style=\"display: none;\">← Previous</button>\n                        <button id=\"wizard-next\" class=\"wizard-btn wizard-primary\">Next →</button>\n                        <button id=\"wizard-finish\" class=\"wizard-btn wizard-primary\" style=\"display: none;\">🎉 Get Started!</button>\n                    </div>\n                </div>\n            </div>\n\n            <!-- Enhanced Loading Overlay -->\n            <div id=\"loading-overlay\" class=\"aria-loading-overlay\">\n                <div class=\"aria-loading-content\">\n                    <button class=\"aria-loading-close\" aria-label=\"Cancel search\">&times;</button>\n                    <div class=\"aria-loading-spinner\"></div>\n                    <div class=\"aria-loading-text\">Searching knowledge base...</div>\n                    <div class=\"aria-loading-subtext\">This may take up to 15 seconds</div>\n                    <div class=\"aria-progress-bar\">\n                        <div class=\"aria-progress-fill\"></div>\n                    </div>\n                    <div class=\"aria-loading-details\">\n                        <div class=\"aria-step active\" id=\"step-1\">⚲ Analyzing your question</div>\n                        <div class=\"aria-step\" id=\"step-2\">⌕ Searching documentation</div>\n                        <div class=\"aria-step\" id=\"step-3\">⟳ Generating response</div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n\n</div>\n\n<!-- Confirmation Modal for Clear History -->\n<div id=\"confirm-clear-modal\" class=\"aria-confirm-modal\">\n    <div class=\"aria-confirm-modal-content\">\n        <button class=\"aria-confirm-close\" title=\"Close\">×</button>\n        <div class=\"aria-confirm-header\">\n            <h3 class=\"aria-confirm-title\">Clear Chat History</h3>\n        </div>\n        <div class=\"aria-confirm-message\">\n            Are you sure you want to clear all chat history? This cannot be undone.\n        </div>\n        <div class=\"aria-confirm-buttons\">\n            <button id=\"confirm-clear-yes\" class=\"aria-confirm-btn aria-confirm-yes\">Yes, Clear All</button>\n            <button id=\"confirm-clear-no\" class=\"aria-confirm-btn aria-confirm-no\">Cancel</button>\n        </div>\n    </div>\n</div>\n\n<!-- jsPDF library for PDF export -->\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js\" crossorigin=\"anonymous\" referrerpolicy=\"no-referrer\"></script>\n\n<!-- Fallback jsPDF from different CDN if first fails -->\n<script>\n  if (typeof window.jsPDF === 'undefined') {\n    console.warn('⚠️ Primary jsPDF CDN failed, trying fallback...');\n    const fallbackScript = document.createElement('script');\n    fallbackScript.src = 'https://unpkg.com/jspdf@2.5.1/dist/jspdf.umd.min.js';\n    fallbackScript.onload = () => console.log('✅ Fallback jsPDF loaded successfully');\n    fallbackScript.onerror = () => console.error('❌ Fallback jsPDF also failed to load');\n    document.head.appendChild(fallbackScript);\n  } else {\n    console.log('✅ Primary jsPDF loaded successfully');\n  }\n</script>\n\n<!-- Load modular components in correct order -->\n<script src=\"search-browser-detection.js\"></script>\n<script src=\"search-audio-manager.js\"></script>\n<script src=\"search-voice-recognition.js\"></script>\n<script src=\"search-state-machine.js\"></script>\n<script src=\"search-pdf-export.js\"></script>\n<script src=\"search-interface.js\"></script>\n\n<!-- Main orchestrator - loads after all components -->\n<script src=\"search-orchestrator.js\"></script>"
