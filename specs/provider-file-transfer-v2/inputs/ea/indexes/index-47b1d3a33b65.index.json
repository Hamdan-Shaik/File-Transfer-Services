    "1": "<meta http-equiv=\"Cache-Control\" content=\"no-cache, no-store, must-revalidate\">\n<meta http-equiv=\"Pragma\" content=\"no-cache\">\n<meta name=\"Expires\" content=\"0\">\n\n<style>\n/* Hide sidebars on this page using body:has selector like Aria search */\nbody:has(.tech-search-container) .md-sidebar,\nbody:has(.tech-search-container) .md-sidebar--primary,\nbody:has(.tech-search-container) .md-sidebar--secondary {\n    display: none !important;\n}\n\n/* Hide H1 Title in Content Area */\nbody:has(.tech-search-container) .md-content__inner.md-typeset h1 {\n    display: none !important;\n}\n\n* {\n    box-sizing: border-box;\n}\n\n/* Tech Search Container */\n.tech-search-container {\n    max-width: 100%;\n    margin: 0 auto;\n}\n\nh1 {\n    color: #1976d2;\n    margin-top: 0;\n    margin-bottom: 30px;\n    font-size: 2em;\n}\n\n/* Filter Section */\n.filter-section {\n    background-color: #f8f9fa;\n    padding: 16px 18px;\n    border-radius: 6px;\n    margin-top: 16px;\n    margin-bottom: 24px;\n    border: 1px solid #dee2e6;\n}\n\n.filter-grid {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));\n    gap: 15px;\n    margin-bottom: 15px;\n}\n\n.filter-group {\n    display: flex;\n    flex-direction: column;\n}\n\n.filter-group label {\n    font-weight: 600;\n    margin-bottom: 4px;\n    color: #495057;\n    font-size: 0.85em;\n}\n\n.filter-group input,\n.filter-group select {\n    padding: 8px 10px;\n    border: 1px solid #ced4da;\n    border-radius: 4px;\n    font-size: 13px;\n    background-color: white;\n}\n\n.filter-group input:focus,\n.filter-group select:focus {\n    outline: none;\n    border-color: #1976d2;\n    box-shadow: 0 0 0 3px rgba(25, 118, 210, 0.1);\n}\n\n.filter-actions {\n    display: flex;\n    gap: 10px;\n    margin-top: 15px;\n    justify-content: flex-end;\n}\n\n.btn {\n    padding: 8px 18px;\n    border: none;\n    border-radius: 4px;\n    cursor: pointer;\n    font-size: 13px;\n    font-weight: 500;\n    transition: all 0.2s;\n}\n\n.btn-primary {\n    background-color: #1976d2;\n    color: white;\n}\n\n.btn-primary:hover {\n    background-color: #1565c0;\n}\n\n.btn-secondary {\n    background-color: #6c757d;\n    color: white;\n}\n\n.btn-secondary:hover {\n    background-color: #5a6268;\n}\n\n/* Results Section */\n.results-header {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 20px;\n    padding-bottom: 10px;\n    border-bottom: 2px solid #dee2e6;\n}\n\n.results-count {\n    font-size: 0.85em;\n    color: #495057;\n}\n\n.results-count strong {\n    color: #1976d2;\n    font-size: 0.9em;\n}\n\n.expand-collapse-controls {\n    display: flex;\n    gap: 10px;\n}\n\n.btn-sm {\n    padding: 4px 10px;\n    font-size: 0.8em;\n    border: 1px solid #dee2e6;\n    background: #fff;\n    border-radius: 4px;\n    cursor: pointer;\n    transition: all 0.2s ease;\n}\n\n.btn-sm:hover {\n    background: #f8f9fa;\n    border-color: #1976d2;\n    color: #1976d2;\n}\n\n.category-group {\n    margin-bottom: 20px;\n    border: 1px solid #dee2e6;\n    border-radius: 6px;\n    overflow: hidden;\n}\n\n.category-header {\n    background-color: #f8f9fa;\n    padding: 12px 18px;\n    cursor: pointer;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    transition: background-color 0.2s;\n    border-bottom: 1px solid #dee2e6;\n}\n\n.category-header:hover {\n    background-color: #e9ecef;\n}\n\n.category-name {\n    font-weight: 600;\n    font-size: 0.95em;\n    color: #212529;\n}\n\n.category-badge {\n    background-color: #1976d2;\n    color: white;\n    padding: 3px 10px;\n    border-radius: 12px;\n    font-size: 0.8em;\n    font-weight: 500;\n}\n\n.category-content {\n    padding: 15px 20px;\n    display: none;\n}\n\n.category-content.expanded {\n    display: block;\n}\n\n.tech-card {\n    padding: 12px 14px;\n    margin-bottom: 8px;\n    background-color: #ffffff;\n    border: 1px solid #e9ecef;\n    border-radius: 4px;\n    transition: all 0.2s;\n}\n\n.tech-card:hover {\n    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\n    border-color: #1976d2;\n}\n\n.tech-name {\n    font-weight: 600;\n    font-size: 0.95em;\n    color: #212529;\n    margin-bottom: 6px;\n}\n\n.tech-details {\n    display: grid;\n    grid-template-columns: 1fr 1fr;\n    gap: 8px;\n    font-size: 0.85em;\n    color: #6c757d;\n}\n\n.tech-detail-item {\n    display: flex;\n    align-items: center;\n    gap: 5px;\n}\n\n.tech-detail-label {\n    font-weight: 500;\n    color: #019681;\n}\n\n.status-badge {\n    padding: 3px 8px;\n    border-radius: 12px;\n    font-size: 0.8em;\n    font-weight: 600;\n    color: white;\n}\n\n.status-standard {\n    background-color: #1976d2;\n}\n.status-contained {\n    background-color: #fd7e14;\n}\n.status-evaluating {\n    background-color: #8c5ced;\n}\n.status-not_chosen {\n    background-color: #dc3545;\n}\n.status-procuring {\n    background-color: #17a2b8;\n}\n.status-retired {\n    background-color: #6c757d;\n}\n\n.preferred-badge {\n    background-color: #ffc107;\n    color: #000;\n    padding: 3px 8px;\n    border-radius: 12px;\n    font-size: 0.8em;\n    font-weight: 600;\n}\n\n.no-results {\n    text-align: center;\n    padding: 60px 20px;\n    color: #6c757d;\n}\n\n.no-results-icon {\n    font-size: 3em;\n    margin-bottom: 15px;\n}\n\n.loading {\n    text-align: center;\n    padding: 60px 20px;\n    color: #6c757d;\n}\n\n.spinner {\n    border: 4px solid #f3f3f3;\n    border-top: 4px solid #1976d2;\n    border-radius: 50%;\n    width: 50px;\n    height: 50px;\n    animation: spin 1s linear infinite;\n    margin: 0 auto 20px;\n}\n\n@keyframes spin {\n    0% {\n        transform: rotate(0deg);\n    }\n    100% {\n        transform: rotate(360deg);\n    }\n}\n\n.error-message {\n    background-color: #f8d7da;\n    color: #721c24;\n    padding: 15px;\n    border-radius: 4px;\n    border: 1px solid #f5c6cb;\n    margin-bottom: 20px;\n}\n\n/* Lifecycle Timeline Styles */\n.lifecycle-timeline {\n    margin: 20px -15px -15px -15px;\n    padding: 20px;\n    background: linear-gradient(to bottom, #ffffff, #f8f9fa);\n    border-top: 2px solid #dee2e6;\n    border-radius: 0 0 4px 4px;\n}\n\n.timeline-stages {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    position: relative;\n    margin-bottom: 20px;\n}\n\n.timeline-line {\n    position: absolute;\n    top: 15px;\n    left: 0;\n    right: 0;\n    height: 4px;\n    background-color: #dee2e6;\n    z-index: 0;\n}\n\n.timeline-progress {\n    position: absolute;\n    top: 15px;\n    left: 0;\n    height: 4px;\n    background: linear-gradient(to right, #28a745, #17a2b8, #007bff, #ffc107, #dc3545);\n    z-index: 1;\n    transition: width 0.3s ease;\n}\n\n.timeline-stage {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    position: relative;\n    z-index: 2;\n    flex: 1;\n}\n\n.timeline-dot {\n    width: 30px;\n    height: 30px;\n    border-radius: 50%;\n    background-color: #fff;\n    border: 3px solid #dee2e6;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 14px;\n    transition: all 0.3s ease;\n}\n\n.timeline-stage.completed .timeline-dot {\n    background-color: #28a745;\n    border-color: #28a745;\n    color: white;\n}\n\n.timeline-stage.current .timeline-dot {\n    background-color: #007bff;\n    border-color: #007bff;\n    color: white;\n    box-shadow: 0 0 0 4px rgba(0, 123, 255, 0.2);\n    animation: pulse 2s infinite;\n}\n\n.timeline-stage.future .timeline-dot {\n    background-color: #fff;\n    border-color: #dee2e6;\n}\n\n.timeline-stage.deprecated .timeline-dot {\n    background-color: #dc3545;\n    border-color: #dc3545;\n    color: white;\n}\n\n@keyframes pulse {\n    0%,\n    100% {\n        box-shadow: 0 0 0 4px rgba(0, 123, 255, 0.2);\n    }\n    50% {\n        box-shadow: 0 0 0 8px rgba(0, 123, 255, 0.1);\n    }\n}\n\n.timeline-label {\n    margin-top: 8px;\n    font-size: 0.75em;\n    font-weight: 600;\n    text-align: center;\n    color: #6c757d;\n    white-space: nowrap;\n}\n\n.timeline-stage.current .timeline-label {\n    color: #007bff;\n    font-weight: 700;\n}\n\n.timeline-stage.completed .timeline-label {\n    color: #28a745;\n}\n\n.timeline-date {\n    font-size: 0.7em;\n    color: #6c757d;\n    margin-top: 2px;\n}\n\n.timeline-date.inferred {\n    font-style: italic;\n    color: #adb5bd;\n}\n\n.timeline-date.inferred::before {\n    content: '~';\n    margin-right: 2px;\n}\n\n.timeline-details {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n    gap: 8px;\n    margin-top: 10px;\n    font-size: 0.85em;\n}\n\n/* Contact Section Styles */\n.contacts-section {\n    background-color: #f8f9fa;\n    padding: 15px;\n    border-radius: 6px;\n    border: 1px solid #e9ecef;\n    grid-column: 1 / -1;\n    margin-top: 15px;\n}\n\n.contacts-grid {\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n    margin-top: 10px;\n}\n\n.contact-item {\n    display: flex;\n    flex-direction: column;\n    gap: 4px;\n    padding: 10px;\n    background-color: white;\n    border-radius: 4px;\n    border: 1px solid #dee2e6;\n}\n\n.contact-type {\n    font-size: 0.75em;\n    text-transform: uppercase;\n    color: #6c757d;\n    font-weight: 600;\n    letter-spacing: 0.5px;\n}\n\n.contact-name {\n    font-size: 0.95em;\n    color: #1976d2;\n    font-weight: 500;\n}\n\n.contact-name a {\n    color: #1976d2;\n    text-decoration: none;\n}\n\n.contact-name a:hover {\n    text-decoration: underline;\n}\n\n/* Hide page-level PDF Download Container */\nbody:has(.tech-search-container) .pdf-download-container {\n    display: none !important;\n}\n</style>\n\n<link rel=\"stylesheet\" href=\"../../assets/stylesheets/app-banner.css\">\n\n<div class=\"app-banner\">\n  <div class=\"app-banner-inner\">\n    <div class=\"app-banner-title-area\">\n      <div>\n        <div class=\"app-banner-title\"><span class=\"app-banner-icon\"><img src=\"../../assets/images/icon-tech-search.svg\" alt=\"Tech Search\"></span> Technology Search</div>\n        <p class=\"app-banner-sub\">Search and explore enterprise technology standards</p>\n      </div>\n    </div>\n    <div class=\"app-banner-badges\">\n      <span class=\"app-badge app-badge-version\">v1.0.0</span>\n      <span class=\"app-badge app-badge-beta\">BETA</span>\n      <img src=\"../../assets/images/icon-pdf.png\" alt=\"Export to PDF\" class=\"app-banner-pdf\" title=\"Export to PDF\" onclick=\"window.print()\" />\n    </div>\n  </div>\n</div>\n\n<div class=\"tech-search-container\" data-environment=\"ENV_PLACEHOLDER\">\n\n    <!-- Filter Section -->\n    <div class=\"filter-section\">\n        <div class=\"filter-grid\">\n            <div class=\"filter-group\">\n                <label for=\"nameFilter\">Technology Name</label>\n                <input\n                    type=\"text\"\n                    id=\"nameFilter\"\n                    placeholder=\"e.g., DynamoDB, AWS, SQL Server\"\n                />\n            </div>\n\n            <div class=\"filter-group\">\n                <label for=\"categoryFilter\">Tech Category</label>\n                <select id=\"categoryFilter\">\n                    <option value=\"\">All Categories</option>\n                </select>\n            </div>\n\n            <div class=\"filter-group\">\n                <label for=\"statusFilter\">Status</label>\n                <select id=\"statusFilter\">\n                    <option value=\"\">All Statuses</option>\n                </select>\n            </div>\n\n            <div class=\"filter-group\">\n                <label for=\"releaseFilter\">Release</label>\n                <input type=\"text\" id=\"releaseFilter\" placeholder=\"e.g., 2022, v1.0\" />\n            </div>\n\n            <div class=\"filter-group\">\n                <label for=\"preferredFilter\">Preferred Technology</label>\n                <select id=\"preferredFilter\">\n                    <option value=\"\">All</option>\n                    <option value=\"yes\">Preferred Only</option>\n                    <option value=\"no\">Non-Preferred Only</option>\n                </select>\n            </div>\n        </div>\n\n        <div class=\"filter-actions\">\n            <button class=\"btn btn-secondary\" onclick=\"resetFilters()\">Reset All</button>\n        </div>\n    </div>\n\n    <!-- Results Section -->\n    <div id=\"resultsSection\">\n        <div class=\"loading\">\n            <div class=\"spinner\"></div>\n            <p>Loading technology data...</p>\n        </div>\n    </div>\n\n</div>\n\n<script src=\"tech-search.js\"></script>"
