{
  "DomainApi": {
    "BaseUrl": "http://fxfer-domain-api",
    "TimeoutSeconds": 10
  },
  "EventBackboneConsumer": {
    "Enabled": false,
    "EventAdapterBaseUrl": "http://event-adapter",
    "SubscriptionName": "fxfer-domain-events",
    "PollIntervalSeconds": 5,
    "TimeoutSeconds": 10
  },
  "TenantDatabase": {
    "DefaultConnectionString": "Host=localhost;Database=fxfer;Username=fxfer;Password=fxfer"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://otel-collector:4317"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
