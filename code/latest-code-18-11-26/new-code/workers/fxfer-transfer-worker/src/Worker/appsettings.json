{
  "DomainApi": {
    "BaseUrl": "http://fxfer-domain-api",
    "TimeoutSeconds": 10
  },
  "EventBackboneConsumer": {
    "Enabled": false,
    "EventAdapterBaseUrl": "http://event-adapter",
    "SubscriptionName": "fxfer-transfer-work-items",
    "PollIntervalSeconds": 5,
    "TimeoutSeconds": 10
  },
  "Secrets": {
    "Provider": "aws",
    "Prefix": "fxfer/tenants"
  },
  "Staging": {
    "RootPath": "/tmp/fxfer-staging"
  },
  "TransferExecution": {
    "MaxAttempts": 3,
    "AttemptBackoffBaseMs": 200
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://otel-collector:4317"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

