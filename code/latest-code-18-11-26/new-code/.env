# This file is loaded by start_codex.ps1.
# Keep it LOCAL. Do not commit real credentials.

# --- Codex / LLM (required by start_codex.ps1) ---
LLM_MODEL=gpt-5.2
OPENAI_BASE_URL=https://us.api.openai.com/v1

# --- LLM provider selection (optional) ---
# If you use OpenAI directly, keep LLM_PROVIDER=openai and set OPENAI_API_KEY.
LLM_PROVIDER=openai

# OpenAI (do not commit real keys)
OPENAI_API_KEY=
LLM_TEMPERATURE=0.2

# Azure OpenAI (alternative)
# LLM_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_DEPLOYMENT_NAME=gpt-4o
# AZURE_API_VERSION=2024-02-15-preview
# AZURE_OPENAI_API_KEY=

# Client certificate auth (mTLS) — use instead of or alongside API key
# CA_BUNDLE_PATH=C:\certs\windows-roots.pem
# CLIENT_KEY_PATH=C:\certs\client.key
# CLIENT_CERT_PATH=C:\certs\client.crt

# --- Optional: local knowledge graph / indexing knobs ---
# Neo4j (only needed if you run graph-backed analysis locally)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# Roslyn
# ROSLYN_ANALYZER_PATH=C:\path\to\roslyn_analyzer

# Indexing / sampling
TREE_SAMPLE_PAGES=150
EA_INDEX_CONCURRENCY=2

LOG_LEVEL=INFO

# --- Repo Roadmap pointers (non-secret) ---
# These are convenience variables for scripts/tools you may use while generating
# a graph and specs. Keep them non-secret.
WORKSPACE_ROOT=.
FXFER_LEGACY_CODE_DIR=mms-cms-fxfer
FXFER_CURRENT_STATE_DOCS_DIR=fxfer-documentation
FXFER_EAP_REF_ARCH_DIR=eap-ref-architecture
FXFER_EAP_POINTERS_DOC=eap-analysis.md
FXFER_ARB_STACK_DOC=ARB-Provider-Plus-Modernization_202606096-v5.md
FXFER_ROADMAP_DOC=roadmap.md
FXFER_TARGET_STATE_DOC=target-state.md
FXFER_TSD_WORK_DIR=tsd-work

# Graph/spec outputs (create directories as needed)
FXFER_ARTIFACTS_DIR=artifacts
FXFER_GRAPH_OUT_DIR=artifacts/graph
FXFER_SPECS_OUT_DIR=artifacts/specs
