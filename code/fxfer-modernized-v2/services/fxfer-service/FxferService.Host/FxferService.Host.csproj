<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <StartupObject>FxferService.Host.Program</StartupObject>
    <NoWarn>$(NoWarn);7022</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.23.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageReference Include="OpenTelemetry.Instrumentation.EntityFrameworkCore" Version="1.20.2-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="tests\\**\\*.cs" />
    <None Remove="tests\\**" />
    <Compile Remove="tools\\**\\*.cs" />
    <None Remove="tools\\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="deploy\contracts\openapi\fxfer-service.openapi.json" CopyToOutputDirectory="PreserveNewest" TargetPath="contracts/openapi/fxfer-service.openapi.json" />
    <None Include="docs\design\seam-contracts\http\fxfer-service.openapi.json" CopyToOutputDirectory="PreserveNewest" TargetPath="docs/design/seam-contracts/http/fxfer-service.openapi.json" />
    <None Include="deploy\contracts\asyncapi\fxfer-service.asyncapi.yaml" CopyToOutputDirectory="PreserveNewest" TargetPath="contracts/asyncapi/fxfer-service.asyncapi.yaml" />
    <None Include="docs\design\seam-contracts\events\fxfer-service.asyncapi.yaml" CopyToOutputDirectory="PreserveNewest" TargetPath="docs/design/seam-contracts/events/fxfer-service.asyncapi.yaml" />
  </ItemGroup>

</Project>



