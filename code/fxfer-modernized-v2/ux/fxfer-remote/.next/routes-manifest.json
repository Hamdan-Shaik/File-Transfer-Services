{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/fxfer/transfer-configurations/[transferConfigurationId]",
      "regex": "^/fxfer/transfer\\-configurations/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtransferConfigurationId": "nxtPtransferConfigurationId"
      },
      "namedRegex": "^/fxfer/transfer\\-configurations/(?<nxtPtransferConfigurationId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/fxfer",
      "regex": "^/fxfer(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/fxfer(?:/)?$"
    },
    {
      "page": "/fxfer/ftp-servers",
      "regex": "^/fxfer/ftp\\-servers(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/fxfer/ftp\\-servers(?:/)?$"
    },
    {
      "page": "/fxfer/transfer-configurations",
      "regex": "^/fxfer/transfer\\-configurations(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/fxfer/transfer\\-configurations(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}