{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "OpenTelemetry": {
    "ServiceName": "fxfer-scheduler-worker",
    "ServiceNamespace": "provider-file-transfer"
  },
  "FxferService": {
    "BaseUrl": ""
  },
  "TenantPolicy": {
    "BaseUrl": ""
  },
  "Scheduling": {
    "TickSeconds": 30,
    "MaxDispatchPerTick": 100
  },
  "Messaging": {
    "Publisher": "in-memory",
    "Producer": "fxfer-scheduler-worker"
  }
}
